# ---- Pappy/Omega environment. Copy to .env. NEVER commit .env. ----
# Telegram bot token (BotFather -> /newbot). REQUIRED — without it the
# controller boots in doctor mode (health endpoints only, no Telegram traffic).
BOT_TOKEN=
# Owner Telegram user IDs, comma-separated, numeric (ask @userinfobot).
OWNER_IDS=
# Service wiring (compose defaults — only change for exotic layouts).
REDIS_URL=redis://redis:6379
PORT=3000
LOG_LEVEL=info
# Local Bot API server: ONLY used with docker-compose.local-api.yml (2GB uploads).
# Default path uses hosted api.telegram.org (50MB cap) — leave these empty.
# BOT_API_ROOT=http://botapi:8081
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# ---- Group-call DJ (stream-worker). Leave empty = worker stays down. ----
# Assistant user-session creds: my.telegram.org app + paired string session
# (generate on YOUR machine, paste here — runbook: docs/70-DEPLOY.md §3).
# NEVER commit real values. Worker refuses to boot without them.
STREAM_API_ID=
STREAM_API_HASH=
STREAM_SESSION_STRING=
# Comma-separated group chat IDs where /play works (empty = disabled everywhere).
STREAM_ALPHA_CHATS=
# Optional: stable worker identity (default: random per boot).
# STREAM_WORKER_ID=w-1
# Tests only. NEVER set in production (fake call engine = silent no-audio).
# STREAM_FAKE_ENGINE=
