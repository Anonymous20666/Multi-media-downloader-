# ---- Pappy/Omega environment. Copy to .env. NEVER commit .env. ----
# Telegram
BOT_TOKEN=
# Local Bot API server (ADR-04, 2000MB uploads). Compose sets this automatically.
# For hosted api.telegram.org (50MB cap), leave empty.
BOT_API_ROOT=http://botapi:8081
# Owner Telegram user IDs (comma-separated, numeric only — §89)
OWNER_IDS=
# Service endpoints (compose defaults shown)
REDIS_URL=redis://redis:6379
DATABASE_URL=postgres://pappy:pappy@postgres:5432/pappy
PORT=3000
LOG_LEVEL=info
# Local Bot API server credentials (from https://my.telegram.org) — required by botapi service
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
