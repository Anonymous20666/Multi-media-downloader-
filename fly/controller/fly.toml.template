# Rendered by scripts/fly-deploy.sh (__PREFIX__/__REGION__ substituted).
# Bot UX + providers + public /healthz /readyz /metrics (read-only JSON).
# Always-on by design: a polling bot must never auto-stop.
app = "__PREFIX__-controller"
primary_region = "__REGION__"

[build]
  dockerfile = "apps/controller/Dockerfile"

[env]
  PORT = "3000"
  LOG_LEVEL = "info"
  NODE_ENV = "production"

[http_service]
  internal_port = 3000
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = true
  [http_service.concurrency]
    type = "requests"
    soft_limit = 25
    hard_limit = 50
  [[http_service.checks]]
    grace_period = "20s"
    interval = "30s"
    method = "GET"
    path = "/readyz"
    protocol = "http"
    timeout = "5s"

[[vm]]
  size = "shared-cpu-1x"
  memory = "1gb"

[[restart]]
  policy = "on-failure"
  retries = 5
